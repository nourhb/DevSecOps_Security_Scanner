# PostgreSQL connection string used by Prisma. Copy this file to .env and set a value.
# Do not commit .env or a real password.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Shared secret the GitHub Actions workflow sends when it posts findings.
# Copy this file to .env and set a value locally. In GitHub, add a repository
# secret with the same name. Do not commit the value.
SECUREREPO_CALLBACK_SECRET=

# Optional. A token with actions:write, used to dispatch security-scan.yml.
# When this is empty, or Actions cannot be reached, the app runs the scanner itself.
SECUREREPO_GITHUB_TOKEN=

# Optional. Public base URL of this app. GitHub Actions posts findings here.
# Local addresses are not used for dispatch.
SECUREREPO_CALLBACK_URL=
